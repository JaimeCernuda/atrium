generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id
  email            String            @unique
  name             String
  imageUrl         String?
  isAdmin          Boolean           @default(false)
  createdAt        DateTime          @default(now())
  lastSeenAt       DateTime?
  presenceSessions PresenceSession[]
  meetingSessions  MeetingSession[]
  sentMessages     Message[]         @relation("SentMessages")
}

model Room {
  id              String   @id
  name            String
  color           String?
  category        String?
  disableMeeting  Boolean  @default(false)
  externalMeetUrl String?
  sortOrder       Int      @default(0)
  ownerEmail      String?
  locked          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sortOrder])
  @@index([ownerEmail])
}

model PresenceSession {
  id        String    @id @default(cuid())
  userId    String
  roomId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, joinedAt])
  @@index([roomId, joinedAt])
  @@index([leftAt])
}

model MeetingSession {
  id        String    @id @default(cuid())
  userId    String
  roomId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([roomId, startedAt])
  @@index([endedAt])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String?
  roomId      String?
  body        String
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([roomId, createdAt])
}

model Digest {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  markdown   String
  title      String?
  authorId   String?
  shareToken String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model Reminder {
  id             String   @id @default(cuid())
  title          String
  body           String?
  dueAt          DateTime
  category       String   @default("other")
  createdById    String?
  createdByBotId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dueAt])
  @@index([createdById])
  @@index([createdByBotId])
}

model BotToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  createdBy  String
  lastUsedAt DateTime?

  @@index([tokenHash])
}
