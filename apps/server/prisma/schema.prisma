generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id
  email            String            @unique
  name             String
  imageUrl         String?
  isAdmin          Boolean           @default(false)
  role             String            @default("external") // soft ref to Role.id
  createdAt        DateTime          @default(now())
  lastSeenAt       DateTime?
  zulipEmail       String?           // Zulip email; defaults to Atrium email at link time
  zulipUserId      Int?              // Zulip internal user id (cache for validation)
  zulipApiKeyEnc   String?           // AES-256-GCM, base64(salt||iv||tag||ciphertext)
  zulipLinkedAt    DateTime?         // when the key was last set
  presenceSessions PresenceSession[]
  meetingSessions  MeetingSession[]
  sentMessages     Message[]         @relation("SentMessages")

  @@index([role])
}

model Role {
  id          String   @id // slug: "owner", "professor", "phd", "student", "external", or custom
  name        String // display label, editable
  permissions String[] // subset of PERMISSION_KEYS (see src/permissions.ts)
  sortOrder   Int      @default(0)
  isProtected Boolean  @default(false) // owner/external: cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Room {
  id              String   @id
  name            String
  color           String?
  category        String?
  disableMeeting  Boolean  @default(false)
  externalMeetUrl String?
  sortOrder       Int      @default(0)
  ownerEmail      String?
  locked          Boolean  @default(false)
  decorations     Json?
  zulipStreamId   Int?      // bound Zulip stream; null = spatial-only room
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([zulipStreamId])
  @@index([sortOrder])
  @@index([ownerEmail])
}

model PresenceSession {
  id        String    @id @default(cuid())
  userId    String
  roomId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, joinedAt])
  @@index([roomId, joinedAt])
  @@index([leftAt])
}

model MeetingSession {
  id        String    @id @default(cuid())
  userId    String
  roomId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([roomId, startedAt])
  @@index([endedAt])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String?
  roomId      String?
  body        String
  createdAt   DateTime @default(now())
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([roomId, createdAt])
}

model Digest {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  markdown   String
  title      String?
  authorId   String?
  shareToken String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model Reminder {
  id             String   @id @default(cuid())
  title          String
  body           String?
  dueAt          DateTime
  category       String   @default("other")
  createdById    String?
  createdByBotId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dueAt])
  @@index([createdById])
  @@index([createdByBotId])
}

model Submission {
  id             String    @id @default(cuid())
  kind           String // "paper" | "poster"
  citationKey    String
  title          String
  authors        String
  venue          String
  year           Int
  pubType        String? // Conference/Journal/Workshop/Preprint (papers only)
  funding        String // grant list or the literal "none"
  resources      String[]  @default([]) // NSF cyberinfrastructure used: Chameleon, Delta, DeltaAI
  githubUrl      String // repo url or the literal "none"
  doi            String? // posters optional; papers set at edit
  abstract       String
  notes          String?
  submitterId    String
  submitterName  String
  submitterEmail String
  files          Json      @default("[]") // [{role, filename, publicUrl}]
  stage          String    @default("new") // paper: new -> edited
  status         String    @default("received") // received|delivering|delivered|failed
  deliveryLog    String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([citationKey])
  @@index([submitterId])
  @@index([status])
}

model BotToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  createdBy  String
  lastUsedAt DateTime?

  @@index([tokenHash])
}
