# ═══════════════════════════════════════════════════════════════════════
# Atrium environment
# Copy to .env and fill in the blanks. See INSTALL.md for a walkthrough.
# ═══════════════════════════════════════════════════════════════════════

# Public URL your users type in (https://gnosis.jcernuda.com etc)
PUBLIC_URL=https://example.com
PORT=8090
TZ=America/Chicago

# Host port that Atrium binds to. Your reverse proxy / tunnel forwards here.
ATRIUM_PORT=8070

# ───── Database ─────
DATABASE_URL=postgresql://atrium:atrium@postgres:5432/atrium

# ───── Admin emails ─────
# JSON array. Matching users become admins on login (see/edit rooms + metrics).
ADMIN_EMAILS=["you@example.com"]

# ───── Access control ─────
# JSON array of suffixes matched with email.endsWith(entry).
# Use "@domain" for entire domains, or a full email for individual allowlisting.
WHITELIST_DOMAINS=["@example.com"]

# ───── Session ─────
# Generate with: openssl rand -hex 32   (64 hex chars)
SESSION_SECRET=replace-with-64-hex-chars
SESSION_COOKIE_NAME=atrium_session

# ───── Branding ─────
BRAND_NAME=My Virtual Office
BRAND_SHORT_NAME=Office
BRAND_LOGO_URL=/brand/gnosis-logo.png
BRAND_ACCENT_COLOR=#1976d2

# ───── Google OAuth ─────
# Optional: leave blank to disable Google sign-in.
# Create a Web OAuth client at https://console.cloud.google.com/apis/credentials
# Redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://example.com/auth/google/callback

# ───── Microsoft / Entra OAuth ─────
# Optional: leave blank to disable Microsoft sign-in.
# Register at https://entra.microsoft.com → Applications → App registrations.
# Redirect URI (Web): ${PUBLIC_URL}/auth/microsoft/callback
# MICROSOFT_TENANT: "common" (any MS account), "organizations" (work/school),
#                   or a specific tenant GUID for single-tenant restriction.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=https://example.com/auth/microsoft/callback
MICROSOFT_TENANT=common

# ───── Rooms ─────
# JSON file mounted read-only; used only as seed data on first startup.
# After first boot rooms live in Postgres and are edited via the Admin UI.
ROOMS_FILE=/config/rooms.json

# ═══════════════════════════════════════════════════════════════════════
# Jitsi (optional, only read when compose is started with --profile jitsi)
# ═══════════════════════════════════════════════════════════════════════

# Public URL of your Jitsi (e.g., https://meet.example.com)
JITSI_PUBLIC_URL=https://meet.example.com

# Public IPv4 of the host running JVB. Clients use this to reach UDP 10000.
# Find with: curl -4 ifconfig.co
JVB_ADVERTISE_IPS=

# Host port for the Jitsi web container. Behind your tunnel/reverse proxy.
JITSI_HTTP_PORT=8075
JICOFO_REST_PORT=8076
JVB_PORT=10000

# Memory caps for the Java services (modest defaults).
JICOFO_MAX_MEMORY=512m
VIDEOBRIDGE_MAX_MEMORY=768m

# Feature flags — leave as-is unless you know what you're changing.
ENABLE_AUTH=0
ENABLE_GUESTS=1

# Shared secrets — populated by scripts/init-jitsi.sh. Do not commit.
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
