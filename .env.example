PUBLIC_URL=https://gnosis.jcernuda.com
PORT=8090

# Postgres connection string (docker-compose provides this via service name)
DATABASE_URL=postgresql://atrium:atrium@postgres:5432/atrium

# Admin emails (JSON array). Matching users become admins on login.
ADMIN_EMAILS=["jaime.cernuda95@gmail.com"]

# Google OAuth (reuse the existing Gnosis OAuth app — same callback URL)
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://gnosis.jcernuda.com/auth/google/callback

# Session — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars
SESSION_COOKIE_NAME=atrium_session

# Access control — JSON array of domain/email suffixes, e.g.
# ["@illinoistech.edu","@hawk.illinoistech.edu","someone@gmail.com"]
WHITELIST_DOMAINS=[]

# Branding (optional; defaults shown)
BRAND_NAME=Atrium
# BRAND_LOGO_URL=https://example.com/logo.svg
BRAND_ACCENT_COLOR=#1976d2

# Rooms config file path inside the container
ROOMS_FILE=/config/rooms.json
